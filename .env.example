# ==============================================================================
# SecureScope — Environment Configuration
# Copy this to .env and adjust values for your environment
# ==============================================================================

# General
NODE_ENV=development
PORT=4000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=securescope
DB_USER=securescope
DB_PASSWORD=securescope
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Security
# IMPORTANT: Change this in production. Must be at least 32 characters.
CREDENTIAL_ENCRYPTION_KEY=change-me-in-production-32char!
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage
# S3_BUCKET=
# S3_REGION=

# Scanner Configuration
SCANNER_DEFAULT_TIMEOUT_MS=300000
SCANNER_MAX_RETRIES=2
SCANNER_ARTIFACT_DIR=./scan-artifacts
SCANNER_WORK_DIR=./scanner-workdir
SCANNER_CONCURRENCY=3

# Logging
LOG_LEVEL=info
